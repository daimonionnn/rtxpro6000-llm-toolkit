# Model checkpoints — hundreds of GB; download them as described in each model's docs/setup.md
/models/

# Runtime output
/logs/
*.pid
__pycache__/
*.pyc

# Editor / agent tool state
/.kilo/
.vscode/
.idea/

# Local Docker image build workspace and the vendored recipe's own git metadata
/*/sglang/build-local-image/.build/
/*/sglang/build-local-image/.git-upstream/

# Engine forks checked out and built locally (e.g. the pennyroyal SGLang fork and its venv)
/*/sglang/pennyroyal-fork/

# NIXL source, NIXL install, compiler caches and HiCache storage, created at build/run time
/*/*/*/nixl-src/
/*/*/*/nixl/
/*/*/*/nixl-storage/
/*/*/*/cache/
