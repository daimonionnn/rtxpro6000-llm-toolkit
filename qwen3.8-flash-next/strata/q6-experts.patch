+__device__ void dq_q6_k(const void* vx, int64_t ibs, dst_t* yy, int tid) {
+    // ggml's dequantize_row_q6_K: two halves of 128, four groups of 32.
+    const block_q6_K& w = ((const block_q6_K*) vx)[ibs];
+    const float d = __half2float(w.d);
+#pragma unroll
+    for (int k = 0; k < 8; ++k) {
+        const int q = tid + 32 * k;
+        const int half = q / 128, quad = (q % 128) / 32;
+        const int low = (w.ql[half * 64 + tid + (quad % 2) * 32] >> (quad >= 2 ? 4 : 0)) & 15;
+        const int high = (w.qh[half * 32 + tid] >> (2 * quad)) & 3;
+        const int code = (low | (high << 4)) - 32;
+        yy[q] = cvt<dst_t>((d * w.scales[q / 16]) * code);
+    }
+}
