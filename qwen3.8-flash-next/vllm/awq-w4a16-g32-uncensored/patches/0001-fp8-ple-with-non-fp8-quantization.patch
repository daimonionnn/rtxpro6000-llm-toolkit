+def _get_ple_embedding_quant_method_from_config(config) -> QuantizeMethodBase | None:
+    """Local patch: an FP8 PLE table next to a non-FP8 main quantization.
+
+    The upstream selector only recognises FP8 PLE shards when the whole checkpoint
+    is FP8 (Fp8Config). An AWQ checkpoint that splices in the official FP8 PLE table
+    declares it with text_config.ple_embedding_dtype instead; without this the table
+    is created in BF16 and the FP8 bytes are copied in without their global scale.
+    """
+    if str(getattr(config, "ple_embedding_dtype", "")).endswith("float8_e4m3fn"):
+        return Qwen3_8FlashNextPLEFp8EmbeddingMethod()
+    return None
+
